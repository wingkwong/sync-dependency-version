{
  "name": "sync-dependency-version",
  "version": "0.2.1",
  "packageManager": "pnpm@10.18.0",
  "description": "Synchronise dependency versions between repositories",
  "author": "WK Wong <wingkwong.code@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/wingkwong/sync-dependency-version",
  "repository": {
    "type": "git",
    "url": "https://github.com/wingkwong/sync-dependency-version.git"
  },
  "keywords": [
    "version",
    "sync",
    "npm",
    "package"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": "./bin/sync-dependency-version.js",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --clean --minify && tsc --emitDeclarationOnly",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
